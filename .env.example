APP_NAME=Investor Intelligence Platform
ENVIRONMENT=development

# Local run (uvicorn on your machine, Postgres in Docker).
# docker-compose overrides this automatically for the api container.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/investor_intelligence

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment NAMES (what you called them in Azure), not model names
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=YOUR_SEARCH_ADMIN_KEY
AZURE_SEARCH_INDEX=investor-documents

EMBEDDING_DIMENSIONS=1536
TOP_K=6
UPLOAD_DIR=data/reports
MAX_UPLOAD_MB=50
